# Copy to .env. Never commit a populated .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
OIDC_ISSUER_URI=https://id.example.eu/realms/prudence
# Expected audience(s) in access tokens addressed to the Prudence API (comma-separated).
OIDC_AUDIENCES=prudence-api
PRUDENCE_ERNEST_BASE_URL=https://ernest.example.eu
# Optional: Ernest split into roles (ERNEST_ROLE) -> base URL = read replicas, this = a writer.
PRUDENCE_ERNEST_WRITE_BASE_URL=
PRUDENCE_ERNEST_API_KEY=replace-with-ernest-api-key
# PDP decisions transport: direct | ingestor | kafka (Ernest ADR-005, the high-volume choice).
PRUDENCE_ERNEST_DECISION_TRANSPORT=direct
PRUDENCE_ERNEST_KAFKA_BOOTSTRAP_SERVERS=
PRUDENCE_ERNEST_KAFKA_TOPIC=prudence.decisions
# Kafka security: production requires SASL_SSL (or SSL); Prudence refuses to start otherwise.
PRUDENCE_ERNEST_KAFKA_SECURITY_PROTOCOL=SASL_SSL
PRUDENCE_ERNEST_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
PRUDENCE_ERNEST_KAFKA_SASL_USERNAME=prudence
PRUDENCE_ERNEST_KAFKA_SASL_PASSWORD=replace-with-kafka-password
PRUDENCE_ERNEST_KAFKA_TRUSTSTORE_LOCATION=
PRUDENCE_ERNEST_KAFKA_TRUSTSTORE_PASSWORD=
PRUDENCE_OPA_POLICY_HASH=sha256-of-the-deployed-opa-bundle
PRUDENCE_OPA_POLICY_VERSION=2026.10.0
# Managed mode is opt-in until existing identities and policies have been migrated.
# It requires HTTPS-protected, authenticated OPA and bundle endpoints in production.
PRUDENCE_MANAGED_ENABLED=false
PRUDENCE_IDENTITY_PRINCIPAL_MODE=legacy
# Policy control-plane actors only; managed mode requires issuer-subject. Unset = principal mode.
# PRUDENCE_IDENTITY_POLICY_ACTOR_MODE=issuer-subject
# PEM CA that signs OPA's TLS certificate, when not publicly trusted.
PRUDENCE_MANAGED_OPA_CA_FILE=
PRUDENCE_IDENTITY_ROLES_CLAIM=roles
PRUDENCE_IDENTITY_ROLE_MAPPING=
PRUDENCE_OPA_BASE_URL=http://opa:8181
PRUDENCE_MANAGED_BUNDLE_KEY=
PRUDENCE_MANAGED_BUNDLE_URL=
PRUDENCE_MANAGED_OPA_TOKEN=
PRUDENCE_MANAGED_OPA_INSTANCE_ID=
PRUDENCE_CORS_ORIGINS=https://prudence.example.eu
SMTP_HOST=smtp.example.eu
SMTP_PORT=587
SMTP_USERNAME=prudence-alerts
SMTP_PASSWORD=replace-with-smtp-password
PRUDENCE_ALERTS_FROM=prudence-alerts@example.eu
PRUDENCE_ALERTS_GOVERNANCE_TO=ai-governance@example.eu
PRUDENCE_ALERTS_OPERATIONS_TO=platform-oncall@example.eu
PRUDENCE_CONSOLE_URL=https://prudence.example.eu
