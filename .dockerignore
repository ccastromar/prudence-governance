# Build contexts are the repository root (backend and console images). Keep them small and never
# send local secrets or build output to the Docker daemon.
.git
.env
.env.*
!.env.example
.claude
CLAUDE.md
.idea
.vscode
*.log
data/
target/
**/node_modules
ui/dist
ui/*.tsbuildinfo
# The backend image does not need integrations. Keep them out by default, but retain the three
# packages and runner source required by integrations/demo-runner/Dockerfile.
integrations/*
!integrations/prudence-core/
!integrations/prudence-core/**
!integrations/pydantic-ai/
!integrations/pydantic-ai/**
!integrations/langgraph/
!integrations/langgraph/**
!integrations/demo-runner/
!integrations/demo-runner/**
integrations/**/.venv/
integrations/**/__pycache__/
integrations/**/*.pyc
integrations/**/*.egg-info/
loadtest/
