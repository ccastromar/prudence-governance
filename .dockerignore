# Build contexts are the repository root (backend and console images). Keep them small and never
# send local secrets or build output to the Docker daemon.
.git
.env
.env.*
!.env.example
.claude
CLAUDE.md
.idea
.vscode
*.log
data/
target/
**/node_modules
ui/dist
ui/*.tsbuildinfo
# The backend image does not need integrations. Keep them out by default, but retain the
# adapters, the runner and the conformance agents and scripted model the demo runner images run
# (integrations/demo-runner/Dockerfile).
integrations/*
!integrations/prudence-core/
!integrations/prudence-core/**
!integrations/pydantic-ai/
!integrations/pydantic-ai/**
!integrations/langgraph/
!integrations/langgraph/**
!integrations/google-adk/
!integrations/google-adk/**
!integrations/openai-agents/
!integrations/openai-agents/**
!integrations/agent-framework/
!integrations/agent-framework/**
!integrations/langchain/
!integrations/langchain/**
!integrations/claude-agent-sdk/
!integrations/claude-agent-sdk/**
!integrations/agno/
!integrations/agno/**
!integrations/smolagents/
!integrations/smolagents/**
!integrations/semantic-kernel/
!integrations/semantic-kernel/**
!integrations/strands-agents/
!integrations/strands-agents/**
!integrations/crewai/
!integrations/crewai/**
!integrations/llamaindex/
!integrations/llamaindex/**
!integrations/demo-runner/
!integrations/demo-runner/**
!integrations/conformance/
integrations/conformance/*
!integrations/conformance/fake_llm.py
!integrations/conformance/agents/
!integrations/conformance/agents/**
integrations/**/.venv/
integrations/**/.venv-*/
integrations/**/__pycache__/
integrations/**/*.pyc
integrations/**/*.egg-info/
loadtest/
