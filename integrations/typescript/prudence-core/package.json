{
  "name": "@chestertown/prudence-core",
  "version": "0.1.0",
  "description": "Framework-agnostic Prudence governance core for TypeScript: the PDP gate, execution reports and Ernest evidence.",
  "license": "Apache-2.0",
  "author": "Carlos Castro Martos",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
