{
  "prudence": {
    "roles_of": {
      "alice@bank.eu": ["model-operator"],
      "bob@bank.eu": ["risk-officer"],
      "service-account-pdp-client": ["model-operator"],
      "service-account-aos-pdp": ["model-operator"]
      ,"service-account-prudence-demo-runner": ["framework-demo-runner"]
    },
    "role_permissions": {
      "model-operator": [
        { "pipeline": "credit-risk-scoring", "actions": ["run"] },
        { "pipeline": "pipeline_aos_support_lookup", "actions": ["run"] },
        { "pipeline": "pipeline_aos_credit_pre_screening", "actions": ["run"] },
        { "pipeline": "pipeline_aos_translate_message", "actions": ["run"] },
        { "pipeline": "pipeline_aos_spam_check", "actions": ["run"] }
      ],
      "risk-officer": [
        { "pipeline": "credit-risk-scoring", "actions": ["run", "approve"] }
      ],
      "framework-demo-runner": [
        { "pipeline": "demo_customer_letter", "actions": ["run"] },
        { "pipeline": "tool:triage_incident", "actions": ["tools/call"] },
        { "pipeline": "tool:deliver_reply", "actions": ["tools/call"] },
        { "pipeline": "tool:queue_claim_letter", "actions": ["tools/call"] },
        { "pipeline": "tool:approve_refund", "actions": ["tools/call"] },
        { "pipeline": "tool:log_customer_call", "actions": ["tools/call"] },
        { "pipeline": "tool:flag_contract_clause", "actions": ["tools/call"] },
        { "pipeline": "tool:schedule_change", "actions": ["tools/call"] },
        { "pipeline": "tool:reorder_stock", "actions": ["tools/call"] },
        { "pipeline": "tool:export_report", "actions": ["tools/call"] },
        { "pipeline": "tool:grant_access", "actions": ["tools/call"] },
        { "pipeline": "tool:onboard_supplier", "actions": ["tools/call"] },
        { "pipeline": "tool:publish_article", "actions": ["tools/call"] },
        { "pipeline": "model:conformance-scripted", "actions": ["invoke"] }
      ]
    },
    "speaks_for": {
      "service-account-ai-gateway": ["service-account-prudence-demo-runner"]
    }
  }
}
